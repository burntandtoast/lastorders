{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packs.burntandtoast.com/v1/pack.schema.json",
  "title": "Model migration pack",
  "description": "Provider-neutral data that drives the scanner, fixer and report. One pack per provider. Packs contain data only; detection patterns are Python-compatible regular expressions with a length cap.",
  "type": "object",
  "required": ["pack_format", "provider", "name", "version", "updated", "status", "sources", "id_patterns", "models"],
  "additionalProperties": false,
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "regex": {"type": "string", "minLength": 1, "maxLength": 300},
    "risk": {"enum": ["high", "medium", "low", "info"]},
    "confidence": {"enum": ["confirmed", "live-tested", "inferred", "example"]},
    "lang": {"enum": ["python", "javascript", "typescript", "yaml", "json", "toml", "ini", "env", "markdown", "text"]},
    "source": {
      "type": "object", "required": ["url", "checked"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string"}, "checked": {"$ref": "#/$defs/date"}}
    }
  },
  "properties": {
    "$schema": {"type": "string"},
    "pack_format": {"const": 1},
    "provider": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string"},
    "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(\\.\\d+)?$", "description": "Calendar version YYYY.MM.DD[.N]; higher wins."},
    "updated": {"$ref": "#/$defs/date"},
    "status": {"enum": ["stable", "stub", "example"]},
    "notes": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "id_patterns": {
      "description": "Regexes for model-id tokens. The engine adds token boundaries.",
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["pattern"], "additionalProperties": false,
                "properties": {"pattern": {"$ref": "#/$defs/regex"},
                               "quoted_only": {"type": "boolean", "description": "Only match inside quotes or after = / : (for ambiguous ids)."}}}
    },
    "fine_tune": {
      "type": "object", "required": ["pattern", "base_group"], "additionalProperties": false,
      "properties": {"pattern": {"$ref": "#/$defs/regex"}, "base_group": {"type": "integer", "minimum": 1},
                     "risk": {"$ref": "#/$defs/risk"}, "notes": {"type": "array", "items": {"type": "string"}}}
    },
    "migrations": {
      "type": "array",
      "items": {"type": "object", "required": ["id", "title", "shutdown"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "announced": {"$ref": "#/$defs/date"},
                               "shutdown": {"$ref": "#/$defs/date"}, "replacement": {"type": "string"},
                               "headline": {"type": "boolean"}, "source": {"type": "string"}}}
    },
    "models": {
      "type": "array",
      "items": {"type": "object", "required": ["id"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "kind": {"enum": ["snapshot", "alias", "family"]},
                               "alias_of": {"type": "string"}, "match": {"enum": ["exact", "prefix"]},
                               "shutdown": {"anyOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
                               "replacement": {"type": "string"}, "migration": {"type": "string"},
                               "section": {"type": "string"}, "confidence": {"$ref": "#/$defs/confidence"},
                               "note": {"type": "string"}, "map_automatically": {"type": "boolean"},
                               "source": {"type": "string"}}}
    },
    "signals": {
      "description": "Call-site / usage detectors. A signal fires for a file when its pattern matches anywhere in it.",
      "type": "array",
      "items": {"type": "object", "required": ["id", "pattern"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "pattern": {"$ref": "#/$defs/regex"},
                               "languages": {"type": "array", "items": {"$ref": "#/$defs/lang"}},
                               "sdk": {"type": "string"}, "description": {"type": "string"}}}
    },
    "rules": {
      "description": "Parameter, endpoint and tool-calling rules applied to findings.",
      "type": "array",
      "items": {"type": "object", "required": ["id", "type", "risk", "message"], "additionalProperties": false,
                "properties": {
                  "id": {"type": "string"},
                  "type": {"enum": ["param_renamed", "param_removed", "param_conditional", "endpoint", "tool_calling", "info"]},
                  "applies_to": {"type": "object", "additionalProperties": false,
                                 "properties": {"replacements": {"type": "array", "items": {"type": "string"}},
                                                "migrations": {"type": "array", "items": {"type": "string"}}}},
                  "when_all": {"type": "array", "items": {"type": "string"}},
                  "when_any": {"type": "array", "items": {"type": "string"}},
                  "unless_any": {"type": "array", "items": {"type": "string"}},
                  "param": {"type": "string"}, "new_param": {"type": "string"},
                  "risk": {"$ref": "#/$defs/risk"}, "message": {"type": "string"},
                  "confidence": {"$ref": "#/$defs/confidence"}, "evidence": {"type": "string"},
                  "fix": {"type": "object", "description": "Machine-readable hint for the auto-fixer (phase 2).",
                          "properties": {"action": {"enum": ["rename_param", "remove_param", "set_param", "move_endpoint", "manual"]}},
                          "additionalProperties": true}
                }}
    },
    "risk_policy": {
      "type": "object", "additionalProperties": false,
      "properties": {"urgent_days": {"type": "integer", "minimum": 0}, "default_risk": {"$ref": "#/$defs/risk"}}
    },
    "replacement_facts": {"type": "object", "additionalProperties": {"type": "object"}},
    "facts": {
      "type": "object", "additionalProperties": false,
      "properties": {"confirmed": {"type": "array", "items": {"type": "string"}},
                     "live_checked_on": {"$ref": "#/$defs/date"},
                     "live": {"type": "array", "items": {"type": "string"}},
                     "unconfirmed": {"type": "array", "items": {"type": "string"}}}
    },
    "report": {
      "type": "object", "additionalProperties": false,
      "properties": {"next_steps": {"type": "array", "items": {"type": "string"}},
                     "fine_tune_advice": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
