    {
      "pattern": "chatgpt-[A-Za-z0-9._-]*[A-Za-z0-9]"
    },
    {
      "pattern": "(?:whisper-1|tts-1(?:-hd)?)"
    },
    {
      "pattern": "o[1-9](?:-(?:mini|pro|preview|deep-research)(?:-[0-9]{4}-[0-9]{2}-[0-9]{2})?|-[0-9]{4}-[0-9]{2}-[0-9]{2})?",
      "quoted_only": true
    }
  ],
  "fine_tune": {
    "pattern": "^ft:([^:]+)",
    "base_group": 1,
    "risk": "high",
    "notes": [
      "No automatic replacement: gpt-6-luna does not support fine-tuning. Options are prompting/few-shot on gpt-6-luna validated with `eval`, or re-training on a fine-tunable model. New fine-tuning jobs stop on 6 Jan 2027."
    ]
  },
