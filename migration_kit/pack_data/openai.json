  "id_patterns": [
    {
      "pattern": "ft:[A-Za-z0-9._-]+(?::[A-Za-z0-9._-]*)*"
    },
    {
      "pattern": "gpt-[0-9][A-Za-z0-9._-]*[A-Za-z0-9]|gpt-[0-9]"
