  "signals": [
    {
      "id": "openai_sdk",
      "sdk": "openai",
      "languages": [
        "python"
      ],
      "pattern": "\\bfrom openai import\\b|\\bimport openai\\b|\\bOpenAI\\(|\\bAsyncOpenAI\\(|\\bAzureOpenAI\\(",
      "description": "openai Python client"
    },
    {
      "id": "openai_sdk",
      "sdk": "openai",
      "languages": [
        "javascript",
        "typescript"
      ],
      "pattern": "from\\s+[\"']openai[\"']|require\\(\\s*[\"']openai[\"']\\s*\\)|new\\s+OpenAI\\(",
      "description": "openai JS/TS client"
    },
    {
      "id": "langchain_openai",
      "sdk": "langchain",
      "languages": [
        "python",
        "javascript",
        "typescript"
      ],
      "pattern": "\\bChatOpenAI\\(|langchain_openai|@langchain/openai",
      "description": "LangChain OpenAI chat model"
    },
    {
      "id": "http_openai",
      "sdk": "http",
      "languages": [
        "python",
        "javascript",
        "typescript",
        "yaml",
        "json",
        "env"
      ],
      "pattern": "api\\.openai\\.com/v1",
      "description": "Plain HTTP calls to the OpenAI API"
    },
    {
      "id": "chat_completions",
      "languages": [
        "python",
        "javascript",
        "typescript"
      ],
      "pattern": "chat\\.completions\\.(?:create|parse|stream)|/v1/chat/completions|ChatCompletion\\.create|\\bChatOpenAI\\(",
      "description": "Chat Completions call site"
    },
    {
      "id": "responses_api",
      "languages": [
        "python",
        "javascript",
        "typescript"
      ],
      "pattern": "responses\\.(?:create|parse|stream)|/v1/responses|use_responses_api\\s*=\\s*True",
      "description": "Responses API call site"
    },
    {
      "id": "tools",
      "languages": [
        "python",
        "javascript",
        "typescript"
      ],
      "pattern": "\\btools\\s*[=:]|tool_choice|\\bfunction_call\\b|\\bfunctions\\s*[=:]|bind_tools\\(",
      "description": "Tool / function calling"
    },
    {
      "id": "legacy_functions",
