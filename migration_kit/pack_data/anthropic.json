  "rules": [
    {
      "id": "claude-sampling-deprecated",
      "type": "param_removed",
      "applies_to": {
        "replacements": [
          "claude-sonnet-5-5",
          "claude-opus-4-8",
          "claude-sonnet-5",
          "claude-opus-5",
          "claude-opus-5-5",
          "claude-opus-4-7",
          "claude-haiku-5-5"
        ]
      },
      "when_any": [
        "claude_sampling"
      ],
      "param": "temperature,top_p,top_k",
      "risk": "high",
      "confidence": "inferred",
      "evidence": "Anthropic docs: temperature/top_p/top_k return 400 at non-default values on Claude 4.7 and later; Python SDK v1.0+ removes them (TypeError). We infer the listed replacements count as '4.7 and later'.",
      "message": "Sets temperature/top_p/top_k: on Claude 4.7 and later models these return HTTP 400 at non-default values, and the anthropic Python SDK v1.0+ raises TypeError. Remove them and guide behaviour with prompting.",
      "fix": {
        "action": "remove_param",
        "params": [
          "temperature",
          "top_p",
          "top_k"
        ]
      }
    }
  ],
